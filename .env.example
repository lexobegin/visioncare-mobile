# ══════════════════════════════════════════════════════════════════════════════
# VisionCare AI — App Móvil — Plantilla de Variables de Entorno (.env.example)
#
# ⚠️ ADVERTENCIA DE SEGURIDAD:
#    - NUNCA subas tu archivo ".env" real a GitHub ni compartas secretos en Git.
#    - Copia este archivo como ".env" en esta misma carpeta y completa los valores.
#    - Este archivo viene configurado POR DEFECTO PARA DESARROLLO LOCAL con Expo Go.
#    - Lee los comentarios para saber cómo cambiarlo al compilar el APK de PRODUCCIÓN.
#    - Expo SOLO expone al cliente las variables con prefijo EXPO_PUBLIC_.
# ══════════════════════════════════════════════════════════════════════════════

# ─── 1. Entorno de Ejecución ───
# 💻 POR DEFECTO (Desarrollo local con Expo Go): development
# 🚀 EN PRODUCCIÓN (Compilación del APK instalable): Cambiar a production
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME="VisionCare AI"

# ─── 2. URL de la API del Backend (NestJS) ───
# 💻 POR DEFECTO (Desarrollo local):
#   - Con cable USB y ADB (recomendado): http://localhost:3000/api/v1
#     (Recuerda ejecutar en tu terminal: adb reverse tcp:3000 tcp:3000)
#   - Con Wi-Fi en la misma red LAN: http://192.168.X.XX:3000/api/v1
#     (Reemplazar por la IP privada de tu PC)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# 🚀 PARA PRODUCCIÓN (Compilación del APK con EAS Build):
#   Descomenta y coloca la URL pública HTTPS de tu servidor en la nube (Railway/Render/VPS)
#   y comenta la línea de localhost anterior:
# EXPO_PUBLIC_API_URL=https://visioncare-backend-production.up.railway.app/api/v1

# ─── 3. Servicio de Inteligencia Artificial (FastAPI) ───
# 💻 Local: http://localhost:8000/api/v1
# 🚀 Producción: URL HTTPS del microservicio IA en la nube
EXPO_PUBLIC_IA_URL=http://localhost:8000/api/v1

# ─── 4. Autenticación Social (OAuth 2.0 con Google) ───
# La librería de autenticación de Expo exige AMBOS Client IDs para funcionar:
#
# 🌐 EXPO_PUBLIC_GOOGLE_CLIENT_ID (Tipo "Aplicación Web"):
#   Obligatorio en OAuth 2.0: Representa la audiencia del Backend NestJS para validar
#   los tokens que emite Google, y sirve de fallback para pruebas en Expo Go.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=tu_cliente_id_web_de_google.apps.googleusercontent.com
#
# 🤖 EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID (Tipo "Android" — CRÍTICO PARA EL APK):
#   ID vinculado directamente al paquete oficial "com.visioncare.ai" y a la firma SHA-1 de EAS.
#   Es el que permite que el APK instalado en teléfonos Android inicie sesión de forma 100% nativa.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=tu_cliente_id_android_de_google.apps.googleusercontent.com

# ─── 5. Otras Integraciones Sociales (Opcionales) ───
EXPO_PUBLIC_FACEBOOK_APP_ID=tu_facebook_app_id
