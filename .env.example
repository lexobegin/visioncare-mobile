# ══════════════════════════════════════════════════════
# VisionCare AI — Móvil — Variables de entorno
# Copiar como ".env" y completar
#
# ⚠️ Expo SOLO expone al cliente las variables con
#    prefijo EXPO_PUBLIC_ (enbuild-time, no dinámicas).
# ══════════════════════════════════════════════════════

# ─── API del backend NestJS ───
# CON DISPOSITIVO FÍSICO POR USB (recomendado):
#   Ejecuta antes:  adb reverse tcp:3000 tcp:3000
#   y usa localhost — el túnel ADB lo lleva al PC.
#
# CON EMULADOR: localhost también funciona (red del host).
#
# SIN ADB (app en Wi-Fi de la LAN): usa la IP del PC:
#   http://192.168.1.XX:3000/api/v1
#   (backend debe escuchar en 0.0.0.0 — ya lo hace)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Servicio IA FastAPI (uso futuro directo; hoy pasa por backend) ───
EXPO_PUBLIC_IA_URL=http://localhost:8000/api/v1

# ─── Nombre de la app ───
EXPO_PUBLIC_APP_NAME="VisionCare AI"